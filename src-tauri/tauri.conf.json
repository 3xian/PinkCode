{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PinkCode",
  "mainBinaryName": "PinkCode",
  "version": "1.0.8",
  "identifier": "com.pinkcode.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "PinkCode",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "dragDropEnabled": false,
        "theme": "Light",
        "backgroundColor": [
          0,
          0,
          0,
          0
        ],
        "transparent": true,
        "windowEffects": {
          "effects": [
            "acrylic",
            "underWindowBackground"
          ],
          "state": "active",
          "radius": 12,
          "color": [
            250,
            244,
            237,
            96
          ]
        },
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 14,
          "y": 18
        }
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost ws://localhost:1420 http://localhost:1420; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEExMEI3MDFBQ0U5RTcxRDcKUldUWGNaN09HbkFMb1g1VitzT3ZyYjJsa0tYdW8vb2s1b2RCb25GdmhVS2hZbVN0UXpYcW5FZVIK",
      "endpoints": [
        "https://github.com/3xian/PinkCode/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
